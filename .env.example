# DEMO MODE (default: on). The app answers every /api/v1 request from sample data kept in the browser,
# so no backend is needed. Set to "false" at build time to use a real backend instead.
# VITE_DEMO_MODE=false

# Client-side (VITE_*): baked into the bundle at build time. Never put secrets here.
# Only relevant when VITE_DEMO_MODE=false:
# Leave VITE_API_BASE_URL unset to use same-origin /api/v1 (recommended; see API_PROXY_TARGET).
# VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_TIMEOUT=10000
VITE_TOKEN_STORAGE_KEY=api_access_token
VITE_ENABLE_API_LOGGING=false
VITE_ENABLE_RETRY_LOGIC=true
VITE_MAX_RETRY_ATTEMPTS=3
# Public URL of this site (canonical links / SEO)
VITE_SITE_URL=http://localhost:3000

# Server-side only (read at runtime by server.js / the Vite dev server)
# Backend that /api and /uploads are forwarded to (only when VITE_DEMO_MODE=false)
API_PROXY_TARGET=http://127.0.0.1:8000
PORT=3000
